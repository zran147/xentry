# xentry V1 environment. Copy to .env and fill in secrets.
# Never commit .env.

# --- DeepSeek / ADK ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
XENTRY_AGENT_RUNTIME=adk
XENTRY_EXTRACTOR_MODEL=deepseek/deepseek-chat
XENTRY_VALIDATOR_MODEL=deepseek/deepseek-chat

# --- Experimental: a model writes the PoC (/experiments only) ---
# Any provider litellm speaks. For a local llama.cpp server, prefix the model
# with openai/ and point the base at its OpenAI-compatible endpoint; the key is
# ignored by llama.cpp but litellm requires one, so a placeholder is fine.
#   llama-server -m qwen2.5-coder-7b-instruct-q5_k_m.gguf -c 16384 --port 8080
# Leaving XENTRY_POC_MODEL empty disables the experimental tab.
XENTRY_POC_MODEL=
# XENTRY_POC_MODEL=openai/qwen2.5-coder-7b-instruct
# XENTRY_POC_API_BASE=http://127.0.0.1:8080/v1
# XENTRY_POC_API_KEY=sk-local
XENTRY_POC_API_BASE=
XENTRY_POC_API_KEY=
# How many times a failed PoC may be rewritten, clamped to 1..10.
XENTRY_POC_ATTEMPTS=3

# --- App ---
# Not read by anything: the app's listen address and port are arguments in
# deploy/xentry.service, and a non-loopback bind is a systemd drop-in (see the
# README). Kept here only because deleting a line people have in their own
# .env would look like the setting moved.
# XENTRY_APP_HOST=127.0.0.1
# XENTRY_APP_PORT=8000
XENTRY_LOG_LEVEL=INFO
XENTRY_DATA_DIR=/var/lib/xentry
XENTRY_DB_PATH=/var/lib/xentry/xentry.db
XENTRY_BROKER_SOCKET=/run/xentry/broker.sock
XENTRY_ALLOWED_HOSTS=
# Optional. NVD allows 5 requests per 30 seconds anonymously and 50 with a key;
# a key only matters when submitting more than a few CVEs in a burst.
# Free from https://nvd.nist.gov/developers/request-an-api-key
XENTRY_NVD_API_KEY=
XENTRY_ARTIFACT_CATALOG=./config/artifacts.yaml
XENTRY_IMAGE_MANIFESTS=./config/image-manifests.yaml
XENTRY_IMAGE_DIR=./var/images
XENTRY_IMAGES_MANIFEST=./var/images/build-results.json
XENTRY_ARTIFACT_DIR=./var/artifacts
XENTRY_ARTIFACT_MANIFEST=./var/artifacts/manifest.json
XENTRY_STEPS_MANIFEST=./targets/steps.yaml
XENTRY_TARGETS_DIR=./targets
XENTRY_START_MIRROR=1
XENTRY_APPLY_NFT=1
# Broker-side, and both off by default: each is reachable from a guest while
# it provisions, so a deployment opts in. The apt mirror serves one timestamped
# snapshot of the Ubuntu archive; the registry mirror serves npm and PyPI
# indexes filtered to what existed before the advisory, plus the node runtime.
# A derived apt target needs the first; an ecosystem target needs the second.
XENTRY_START_APT_PROXY=1
XENTRY_START_REGISTRY_PROXY=1
XENTRY_QEMU_USER=xentry-vm

# --- Budgets (revision 5) ---
XENTRY_MAX_TOKENS_PER_JOB=150000
XENTRY_PER_CALL_TOKENS=20000
XENTRY_MAX_VM_MINUTES=120
XENTRY_JOB_DEADLINE_S=7200
XENTRY_JOB_TIMEOUT_PHP=5400
XENTRY_JOB_TIMEOUT_GITLAB=7200
XENTRY_JOB_TIMEOUT_DIRTYFRAG=5400
