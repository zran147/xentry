# xentry V1 environment. Copy to .env and fill in secrets.
# Never commit .env.

# --- DeepSeek / ADK ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
XENTRY_AGENT_RUNTIME=adk
XENTRY_EXTRACTOR_MODEL=deepseek/deepseek-chat
XENTRY_VALIDATOR_MODEL=deepseek/deepseek-chat

# --- Experimental: a model writes the PoC (/experiments only) ---
# Any provider litellm speaks. For a local llama.cpp server, prefix the model
# with openai/ and point the base at its OpenAI-compatible endpoint; the key is
# ignored by llama.cpp but litellm requires one, so a placeholder is fine.
#   llama-server -m qwen2.5-coder-7b-instruct-q5_k_m.gguf -c 16384 --port 8080
# Leaving XENTRY_POC_MODEL empty disables the experimental tab.
XENTRY_POC_MODEL=
# XENTRY_POC_MODEL=openai/qwen2.5-coder-7b-instruct
# XENTRY_POC_API_BASE=http://127.0.0.1:8080/v1
# XENTRY_POC_API_KEY=sk-local
XENTRY_POC_API_BASE=
XENTRY_POC_API_KEY=
# How many times a failed PoC may be rewritten, clamped to 1..10.
XENTRY_POC_ATTEMPTS=3

# --- App ---
# Every path here is ABSOLUTE. They used to be relative - ./var/artifacts,
# ./targets - which resolved against whatever the working directory happened to
# be. install.sh overrode some of them and not others, so a deployed host ended
# up reading artifacts from /opt/xentry/var/artifacts while its manifest named
# /var/lib/xentry/artifacts/manifest.json: two directories, 1.1G of files in
# the one nothing consulted, and a manifest describing the other.
# Not read by anything. The listen address is XENTRY_BIND_ADDR above, which
# install.sh turns into a systemd drop-in over the unit's ExecStart. These two
# are kept only because deleting a line people have in their own .env would
# look like the setting moved.
# XENTRY_APP_HOST=127.0.0.1
# XENTRY_APP_PORT=8000
XENTRY_LOG_LEVEL=INFO
XENTRY_DATA_DIR=/var/lib/xentry
XENTRY_DB_PATH=/var/lib/xentry/xentry.db
XENTRY_BROKER_SOCKET=/run/xentry/broker.sock
XENTRY_ALLOWED_HOSTS=
# WHERE THE APP LISTENS. Empty means 127.0.0.1 only, and nothing on the network
# can reach it - this is a bind, not a Host-header question, so adding an
# address to XENTRY_ALLOWED_HOSTS above does NOT publish the app. install.sh
# reads this and writes a systemd drop-in that overrides the unit's ExecStart.
XENTRY_BIND_ADDR=
# The source addresses allowed to reach that port, space separated, IPv4 or
# IPv6, address or CIDR. REQUIRED once XENTRY_BIND_ADDR is set, because the app
# has NO authentication: anything that can reach the port can submit a job that
# detonates a real exploit on this host and can read every stored artifact.
# DEV=1 with this empty means 0.0.0.0/0 - any source - and says so loudly.
XENTRY_ADMIN_IPS=
# Optional. NVD allows 5 requests per 30 seconds anonymously and 50 with a key;
# a key only matters when submitting more than a few CVEs in a burst.
# Free from https://nvd.nist.gov/developers/request-an-api-key
XENTRY_NVD_API_KEY=
# Optional, and the one to set before any sweep. GitHub allows 60 requests an
# hour PER ADDRESS unauthenticated, and a check spends one on the repository
# listing. Sixty CVEs exhausts it, and every check after that reads an EMPTY
# listing - which the extractor reports as "the PoC text does not name a file
# that runs the exploit", a verdict about content for a list it never read.
# Thirteen of twenty-four refusals carried that message on 2026-11-15 after a
# screening script spent the hour. A token raises the limit to 5,000.
# A fine-grained token with NO scopes is enough: it only reads public repos.
# Sent only to api.github.com, checked per request, like the NVD key.
XENTRY_GITHUB_TOKEN=
XENTRY_ARTIFACT_CATALOG=/opt/xentry/config/artifacts.yaml
XENTRY_IMAGE_MANIFESTS=/opt/xentry/config/image-manifests.yaml
XENTRY_IMAGE_DIR=/var/lib/xentry/images
XENTRY_IMAGES_MANIFEST=/var/lib/xentry/images/build-results.json
XENTRY_ARTIFACT_DIR=/var/lib/xentry/artifacts
XENTRY_ARTIFACT_MANIFEST=/var/lib/xentry/artifacts/manifest.json
XENTRY_STEPS_MANIFEST=/opt/xentry/targets/steps.yaml
XENTRY_TARGETS_DIR=/opt/xentry/targets
XENTRY_APPLY_NFT=1
# Broker-side, and both off by default: each is reachable from a guest while
# it provisions, so a deployment opts in. The apt mirror serves one timestamped
# snapshot of the Ubuntu archive; the registry mirror serves npm and PyPI
# indexes filtered to what existed before the advisory, plus the node runtime.
# A derived apt target needs the first; an ecosystem target needs the second.
XENTRY_START_APT_PROXY=1
XENTRY_START_REGISTRY_PROXY=1
XENTRY_QEMU_USER=xentry-vm

# --- Budgets (revision 5) ---
XENTRY_MAX_TOKENS_PER_JOB=150000
XENTRY_PER_CALL_TOKENS=20000
XENTRY_MAX_VM_MINUTES=120
XENTRY_JOB_DEADLINE_S=7200
XENTRY_JOB_TIMEOUT_PHP=5400
XENTRY_JOB_TIMEOUT_GITLAB=7200
XENTRY_JOB_TIMEOUT_DIRTYFRAG=5400
