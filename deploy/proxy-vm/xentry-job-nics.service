[Unit]
Description=xentry: address the job bridges and serve DHCP on them
Documentation=file:///opt/xentry/docs/adr/0002-mirrors-in-their-own-vm.md
After=network-online.target nftables.service
Wants=network-online.target
# Without the filter loaded this VM has a route to the operator's LAN, so not
# routing is better than routing unfiltered.
Requires=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/xentry-mirror/job-nics.sh

[Install]
WantedBy=multi-user.target
