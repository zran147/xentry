[Unit]
Description=xentry web app (unprivileged)
After=network.target xentry-broker.service
Wants=xentry-broker.service

[Service]
Type=simple
User=xentry
Group=xentry
Environment=HOME=/var/lib/xentry
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/xentry
EnvironmentFile=/etc/xentry/app.env
ExecStart=/opt/xentry/.venv/bin/uvicorn xentry.web.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/xentry
UMask=0077

[Install]
WantedBy=multi-user.target
