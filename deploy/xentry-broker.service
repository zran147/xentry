[Unit]
Description=xentry root broker
After=libvirtd.service
Requires=libvirtd.service

[Service]
Type=simple
User=root
Group=xentry
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/xentry
RuntimeDirectory=xentry
RuntimeDirectoryMode=0750
EnvironmentFile=-/etc/xentry/broker.env
ExecStart=/opt/xentry/.venv-broker/bin/python -m broker.main
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/xentry /run/xentry
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
UMask=0077

[Install]
WantedBy=multi-user.target
